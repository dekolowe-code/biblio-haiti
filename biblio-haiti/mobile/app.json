{
  "expo": {
    "name": "Biblio-Haïti",
    "slug": "biblio-haiti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7B2CBF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bibliohaiti.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cette application nécessite l'accès à votre bibliothèque pour sélectionner des images de profil.",
        "NSCameraUsageDescription": "Cette application nécessite l'accès à la caméra pour prendre des photos de profil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7B2CBF"
      },
      "package": "com.bibliohaiti.app",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "apiUrl": "http://localhost:8000"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker"
    ]
  }
}
